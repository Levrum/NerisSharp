<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageId>Levrum.NerisSharp</PackageId>
    <Title>NerisSharp</Title>
    <Company>Levrum</Company>
    <Authors>levrum-david</Authors>
    <Description>A C# Library to interact with the NERIS API</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>neris;fire;ems</PackageTags>
    <PackageIcon>logo_mark only.png</PackageIcon>
    <VersionPrefix>1.0.4</VersionPrefix>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="2.1.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
    <PackageReference Include="System.Net.Http.Json" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NerisSharpTest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\Resources\logo_mark only.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
